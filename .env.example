# ==============================================================================
#                      IT TASK MANAGER - ENVIRONMENT TEMPLATE
# ==============================================================================

# ── 1. Server Configuration ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── 2. PostgreSQL Database Connection String ─────────────────────────────────
# For Supabase Free Tier, use Port 6543 (Transaction Mode Pooler) to avoid EMAXCONNSESSION:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── 3. Database Connection Pool Scaling (Free Tier Optimized) ────────────────
DB_POOL_MAX=25
DB_POOL_MIN=4
DB_CONNECTION_TIMEOUT_MS=20000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_USES=7500

# ── 4. API Rate Limiter & Concurrency ─────────────────────────────────────────
RATE_LIMIT_MAX=10000
DISABLE_RATE_LIMIT=false

# ── 5. Security & Authentication ──────────────────────────────────────────────
JWT_SECRET=
CRON_SECRET=

# ── 6. Frontend URL for CORS ──────────────────────────────────────────────────
FRONTEND_URL=https://it-taskmanager-6rgp.onrender.com

# ── 7. Cloudinary Configuration (Proof Screenshot CDN Storage) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 8. Telegram Bot Automated Notifications ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=IT_TaskManager_Alerts_bot
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# ── 9. GitHub API Token & Repository (Student Coding Progress Tracking) ───────
# Scopes required: read:user, public_repo
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=Tharun4743/IT_taskmanager

# ── 10. Web Push Notifications (VAPID PWA / Lock-Screen Direct Alerts) ────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vsbecitc2428@gmail.com

# ── 11. Automated Email Service (Brevo Multi-Account Pool & Load Balancer) ────
# All nodes operate exclusively over HTTPS Port 443 (100% Cloud & Render Safe)
# Automated background broadcasts disabled to prevent duplicate emails across multiple deployments
# Task verification / approval status emails disabled
# Password Reset OTP and Manual HOD reminders remain fully functional
DISABLE_AUTOMATED_EMAIL_BROADCASTS=true
ENABLE_TASK_STATUS_EMAILS=false
ENABLE_EMAIL_SERVICE=true

# Brevo Node 1 - Primary (vsbecitc2428@gmail.com)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=vsbecitc2428@gmail.com
BREVO_SENDER_NAME=VSBEC IT Department

# Brevo Node 2 - Secondary (campusvsb4743@gmail.com)
BREVO_API_KEY_2=
BREVO_SENDER_EMAIL_2=campusvsb4743@gmail.com
BREVO_SENDER_NAME=VSBEC IT Department

# Brevo Node 3 - Tertiary (campusconnectvsb@gmail.com)
BREVO_API_KEY_3=
BREVO_SENDER_EMAIL_3=campusconnectvsb@gmail.com
BREVO_SENDER_NAME=VSBEC IT Department
