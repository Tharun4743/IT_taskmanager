# Server Configuration
PORT=3000

# PostgreSQL Connection String
DATABASE_URL=

# Database Connection Pool Scaling (Adjust for high concurrent user load)
DB_POOL_MAX=30
DB_POOL_MIN=4
DB_CONNECTION_TIMEOUT_MS=20000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_USES=7500

# High-Concurrency Rate Limiting (Requests per 15 mins for campus WiFi / NAT IP)
RATE_LIMIT_MAX=10000
DISABLE_RATE_LIMIT=false

# JWT Authentication
JWT_SECRET=

# Cloudinary (Screenshot Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production Frontend URL for CORS (Optional)
FRONTEND_URL=

# GitHub Personal Access Token — Required for GitHub coding progress tracking
# Scopes needed: read:user, public_repo
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Telegram Bot Automated Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# Web Push Notifications (PWA / Mobile / Desktop Lock-screen Alerts)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@vsbec.ac.in

