{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist-server",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false
  },
  "include": [
    "server.ts",
    "db.ts",
    "emailService.ts",
    "pushNotificationService.ts",
    "telegramService.ts",
    "studentDirectoryService.ts",
    "imageCleanupService.ts",
    "dbBackupService.ts",
    "sentryService.ts"
  ],
  "exclude": [
    "node_modules",
    "src",
    "dist"
  ]
}
